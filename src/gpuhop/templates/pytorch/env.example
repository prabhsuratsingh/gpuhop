# Copy to .env (gitignored; never pushed to the GPU box) and fill in.
# Vast.ai API key: https://cloud.vast.ai/manage-keys/
VAST_API_KEY=
# Optional: the private key ssh should use (default: OpenSSH picks ~/.ssh/id_*). Its .pub must be registered
# at https://cloud.vast.ai/manage-keys/
# GPUB_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# Only for code.mode: git -- fine-grained GitHub PAT, this repo only, "Contents: Read-only".
# GPUB_GH_TOKEN=
